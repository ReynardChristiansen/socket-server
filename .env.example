# Redis dari Vercel Marketplace (Storage -> Redis). Setelah di-connect ke project,
# tarik nilainya dengan: vercel env pull
#
# Lokal tanpa Marketplace:
#   docker run -d -p 6379:6379 --name socket-redis redis
#   REDIS_URL=redis://localhost:6379
#
# Tanpa REDIS_URL server tetap jalan, tapi presence & history kosong dan broadcast
# cuma sampai ke koneksi di satu instance. Jangan dipakai di production.
REDIS_URL=
